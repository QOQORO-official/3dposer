{
  "name": "3dposer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Detect a pose from an image, refine it into 3D with Claude, and edit an anatomical mannequin.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "express": "^5.3.0",
    "lil-gui": "^0.21.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
